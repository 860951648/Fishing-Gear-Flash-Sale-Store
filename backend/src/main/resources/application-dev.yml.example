# 本地开发配置样例：复制为 application-dev.yml 后按需修改（application-dev.yml 已被 .gitignore 排除）
# 启动方式：java -jar target/trade-1.0.0.jar --spring.profiles.active=dev
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/trade_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    # 本地 MySQL 密码，仅用于开发
    password: root
  data:
    redis:
      host: localhost
      port: 6379
      database: 0
  rabbitmq:
    host: localhost
    port: 5672
    username: guest
    password: guest

app:
  jwt:
    # 生产环境请用环境变量 JWT_SECRET 注入，不要提交到仓库
    secret: dev-jwt-secret-at-least-32-bytes-long!!
    expire-minutes: 120
  pay:
    secret: dev-pay-secret
    timestamp-tolerance-seconds: 300
  mq:
    # 本机未安装 RabbitMQ 时保持 false，关单改由 OrderCloseTask（每分钟扫描）兜底
    enabled: false
    delay-minutes: 30

logging:
  level:
    com.pyh.trade: debug
    com.pyh.trade.mapper: debug
